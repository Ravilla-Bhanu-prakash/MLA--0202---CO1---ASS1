from sklearn.datasets import load_wine
from sklearn.preprocessing import StandardScaler
from sklearn.decomposition import PCA, FactorAnalysis, FastICA
import matplotlib.pyplot as plt

# Load Wine dataset
wine = load_wine()
X = wine.data
y = wine.target

# Standardize features
X = StandardScaler().fit_transform(X)

# PCA
pca = PCA(n_components=2)
X_pca = pca.fit_transform(X)

# Factor Analysis
fa = FactorAnalysis(n_components=2, random_state=42)
X_fa = fa.fit_transform(X)

# ICA
ica = FastICA(n_components=2, random_state=42, max_iter=1000)
X_ica = ica.fit_transform(X)

# Print component information
print("Original features:", X.shape[1])
print("Reduced features:", X_pca.shape[1])

print("\nPCA Explained Variance:")
print(pca.explained_variance_ratio_)
print("Total PCA variance:",
      round(sum(pca.explained_variance_ratio_), 3))

print("\nPCA Components:")
print(pca.components_)

print("\nFactor Analysis Components:")
print(fa.components_)

print("\nICA Components:")
print(ica.components_)

# PCA Visualization
plt.scatter(X_pca[:, 0], X_pca[:, 1], c=y, cmap="viridis")
plt.xlabel("PCA Component 1")
plt.ylabel("PCA Component 2")
plt.title("Wine Dataset - PCA")
plt.show()

# Factor Analysis Visualization
plt.scatter(X_fa[:, 0], X_fa[:, 1], c=y, cmap="viridis")
plt.xlabel("Factor 1")
plt.ylabel("Factor 2")
plt.title("Wine Dataset - Factor Analysis")
plt.show()

# ICA Visualization
plt.scatter(X_ica[:, 0], X_ica[:, 1], c=y, cmap="viridis")
plt.xlabel("ICA Component 1")
plt.ylabel("ICA Component 2")
plt.title("Wine Dataset - ICA")
plt.show()
