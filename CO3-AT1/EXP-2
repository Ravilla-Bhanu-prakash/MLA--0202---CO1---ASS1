from sklearn.datasets import load_digits
from sklearn.preprocessing import StandardScaler
from sklearn.cluster import KMeans
from sklearn.mixture import GaussianMixture
from sklearn.decomposition import PCA
from sklearn.metrics import silhouette_score, adjusted_rand_score
import matplotlib.pyplot as plt

# Load Digits dataset
digits = load_digits()
X = digits.data
y = digits.target

# Preprocess
X = StandardScaler().fit_transform(X)

# K-Means
kmeans = KMeans(n_clusters=10, random_state=42, n_init=10)
k_labels = kmeans.fit_predict(X)

# Gaussian Mixture Model (EM Algorithm)
gmm = GaussianMixture(n_components=10, random_state=42)
g_labels = gmm.fit_predict(X)

# Evaluation
k_silhouette = silhouette_score(X, k_labels)
gmm_silhouette = silhouette_score(X, g_labels)

k_ari = adjusted_rand_score(y, k_labels)
gmm_ari = adjusted_rand_score(y, g_labels)

print("K-Means Results")
print("Silhouette Score:", round(k_silhouette, 3))
print("Adjusted Rand Index:", round(k_ari, 3))

print("\nGaussian Mixture Model Results")
print("Silhouette Score:", round(gmm_silhouette, 3))
print("Adjusted Rand Index:", round(gmm_ari, 3))

# PCA to 2 dimensions
pca = PCA(n_components=2)
X_pca = pca.fit_transform(X)

# Visualize K-Means
plt.scatter(X_pca[:, 0], X_pca[:, 1],
            c=k_labels, cmap="viridis", s=10)
plt.title("Digits Clustering - K-Means")
plt.xlabel("PCA 1")
plt.ylabel("PCA 2")
plt.show()

# Visualize GMM
plt.scatter(X_pca[:, 0], X_pca[:, 1],
            c=g_labels, cmap="viridis", s=10)
plt.title("Digits Clustering - Gaussian Mixture Model")
plt.xlabel("PCA 1")
plt.ylabel("PCA 2")
plt.show()
