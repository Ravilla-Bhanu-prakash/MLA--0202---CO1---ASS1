import pandas as pd
import matplotlib.pyplot as plt
from sklearn.preprocessing import StandardScaler
from sklearn.cluster import KMeans
from sklearn.decomposition import PCA
from sklearn.metrics import silhouette_score

# Input data
data = {
    "Age": [19, 21, 20, 23, 31, 22, 35, 23, 64, 30,
            67, 35, 58, 24, 37, 22, 35, 20, 52, 35],
    "Income": [15, 15, 16, 16, 17, 17, 18, 18, 19, 19,
               19, 19, 20, 20, 20, 20, 21, 21, 23, 23],
    "Spending": [39, 81, 6, 77, 40, 76, 6, 94, 3, 72,
                 14, 99, 15, 77, 13, 79, 35, 66, 29, 98]
}

df = pd.DataFrame(data)

# Preprocessing
X = StandardScaler().fit_transform(df)

# Elbow Method
inertia = []

for k in range(2, 11):
    model = KMeans(n_clusters=k, random_state=42, n_init=10)
    model.fit(X)
    inertia.append(model.inertia_)

plt.plot(range(2, 11), inertia, marker="o")
plt.xlabel("Number of Clusters")
plt.ylabel("Inertia")
plt.title("Elbow Method")
plt.show()

# Silhouette Score
print("Silhouette Scores:")

for k in range(2, 11):
    model = KMeans(n_clusters=k, random_state=42, n_init=10)
    labels = model.fit_predict(X)
    score = silhouette_score(X, labels)
    print(k, ":", round(score, 3))

# K-Means with 5 clusters
kmeans = KMeans(n_clusters=5, random_state=42, n_init=10)
df["Cluster"] = kmeans.fit_predict(X)

# PCA
pca = PCA(n_components=2)
X_pca = pca.fit_transform(X)

# Cluster visualization
plt.scatter(X_pca[:, 0], X_pca[:, 1],
            c=df["Cluster"], cmap="viridis", s=60)

plt.xlabel("Principal Component 1")
plt.ylabel("Principal Component 2")
plt.title("Customer Segmentation using K-Means and PCA")
plt.show()

# Results
print("\nCluster Counts:")
print(df["Cluster"].value_counts().sort_index())

print("\nCustomer Data with Clusters:")
print(df)
