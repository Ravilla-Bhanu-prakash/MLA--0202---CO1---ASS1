import pandas as pd
from sklearn.naive_bayes import BernoulliNB
data = {
    "Fever": [1, 1, 0, 1, 0, 0],
    "Cough": [1, 0, 1, 1, 0, 1],
    "Headache": [1, 1, 0, 1, 0, 0],
    "Flu": [1, 1, 0, 1, 0, 0]   # 1 = Flu, 0 = No Flu
}

df = pd.DataFrame(data)
X = df[["Fever", "Cough", "Headache"]]
y = df["Flu"]
model = BernoulliNB()
model.fit(X, y)
new_patient = [[1, 1, 1]]
prediction = model.predict(new_patient)
if prediction[0] == 1:
    print("Patient has Flu")
else:
    print("Patient does not have Flu")
